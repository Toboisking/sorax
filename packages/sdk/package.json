{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.1.4",
  "name": "@sorax/sdk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/sorax.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./workerd": "./src/workerd.ts",
    "./workerd/effect": "./src/effect/workerd.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "tsc -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@sorax/client": "workspace:*",
    "@sorax/core": "workspace:*",
    "@sorax/plugin": "workspace:*",
    "@sorax/schema": "workspace:*",
    "@sorax/server": "workspace:*",
    "@sorax/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@sorax/ai": "workspace:*",
    "@sorax/httpapi-codegen": "workspace:*",
    "@sorax/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}
