{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@sorax/plugin-figma",
  "version": "2.1.4",
  "description": "Figma MCP integration and official Figma skills for SORAX",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/sorax.git",
    "directory": "packages/plugins/figma"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "files": [
    "index.ts",
    "skills",
    "skills-source.json"
  ],
  "scripts": {
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "sync:skills": "bun run script/sync-skills.ts"
  },
  "dependencies": {
    "gray-matter": "4.0.3"
  },
  "peerDependencies": {
    "@sorax/plugin": "^2.0.27 || ^0.0.0-dev"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta"
  }
}
